{
  "name": "case1_geomodeling",
  "type": "2d",
  "image_size": 64,

  "unconditional": {
    "timesteps": 1500,
    "channels": 1,
    "dim": 64,
    "dim_mults": [1, 2, 4],
    "beta_schedule": "linear",
    "training": {
      "epochs": 300,
      "batch_size": 256,
      "lr": 1e-3,
      "loss": "huber"
    }
  },

  "conditional": {
    "timesteps": 1500,
    "in_channel": 5,
    "out_channel": 1,
    "inner_channel": 64,
    "channel_mults": [1, 2, 4],
    "attn_res": [16],
    "num_head_channels": 32,
    "res_blocks": 2,
    "dropout": 0.2,
    "beta_schedule": {
      "train": {
        "schedule": "cosine",
        "n_timestep": 1500,
        "linear_start": 1e-6,
        "linear_end": 0.01
      },
      "test": {
        "schedule": "cosine",
        "n_timestep": 1500,
        "linear_start": 1e-4,
        "linear_end": 0.09
      }
    },
    "training": {
      "epochs": 1000,
      "batch_size": 64,
      "lr": 5e-5,
      "loss": "mse",
      "ema_decay": 0.9999
    }
  },

  "data": {
    "train_path": "path/to/train/data",
    "mask_path": "path/to/masks",
    "test_image_path": "/home/groups/mukerji/minghuix/2_Conditional_Diffusion/dataset3f/test_imag",
    "test_mask_path": "/home/groups/mukerji/minghuix/2_Conditional_Diffusion/dataset3f/test_mask"
  },

  "checkpoints": {
    "unconditional": "checkpoints/case1_geomodeling/unconditional.pth",
    "conditional": "checkpoints/case1_geomodeling/conditional.pth"
  }
}
