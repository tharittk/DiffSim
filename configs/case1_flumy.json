{
    "name": "case1_flumy",
    "type": "2d",
    "image_size": 64,
    "dataset_type": "flumy",
    "conditional": {
        "timesteps": 1500,
        "in_channel": 2,
        "out_channel": 1,
        "inner_channel": 64,
        "channel_mults": [
            1,
            2,
            4
        ],
        "attn_res": [
            16
        ],
        "num_head_channels": 32,
        "res_blocks": 2,
        "dropout": 0.2,
        "predict_type": "epsilon",
        "_predict_type_options": [
            "epsilon",
            "x_start"
        ],
        "_conditioning_channels_note": "in_channel=2: [rms] + y_t",
        "beta_schedule": {
            "train": {
                "schedule": "cosine",
                "n_timestep": 1500,
                "linear_start": 1e-6,
                "linear_end": 0.01
            },
            "test": {
                "schedule": "cosine",
                "n_timestep": 1500,
                "linear_start": 1e-4,
                "linear_end": 0.09
            }
        },
        "data": {
            "train_image": "/mnt/sda_data/tharitt/diffsim/data/slice_data_2d/train",
            "test_image": "/mnt/sda_data/tharitt/diffsim/data/slice_data_2d/test"
        },
        "training": {
            "epochs": 250,
            "batch_size": 64,
            "lr": 5e-5,
            "loss": "mse",
            "ema_decay": 0.9999,
            "save_every": 10000,
            "checkpoint_every": 50,
            "balance_by_ng_isbx": true,
            "balance_group_power": 1.0,
            "deterministic": false,
            "enable_tf32": true,
            "cudnn_benchmark": true,
            "amp": true,
            "amp_dtype": "bfloat16",
            "num_workers": 8,
            "persistent_workers": true,
            "prefetch_factor": 4,
            "sample_scale_weights": {
                "local": 1.0,
                "frame_128": 1.25,
                "frame_256": 2.0
            }
        },
        "output": {
            "results_dir": "/mnt/sda_data/tharitt/diffsim/results/case1_flumy_conditional",
            "model_dir": "/mnt/sda_data/tharitt/diffsim/model/case1_flumy_conditional",
            "log_dir": "/mnt/sda_data/tharitt/diffsim/logs/case1_flumy_conditional"
        }
    },
    "checkpoints": {
        "conditional": "/mnt/sda_data/tharitt/diffsim/checkpoints/case1_flumy/conditional.pth"
    }
